#!/bin/sh

set -eu

if ! command -v git-secrets >/dev/null 2>&1; then
  echo "git-secrets is not installed or not in PATH." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed or not in PATH." >&2
  exit 1
fi

echo "[pre-push] git-secrets: scanning repository history"
git secrets --scan-history

echo "[pre-push] gitleaks: scanning git history"
gitleaks git --no-banner .
